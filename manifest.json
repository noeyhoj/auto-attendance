{
  "manifest_version": 3,
  "name": "LMS+ 출석 도우미",
  "description": "LMS+ 페이지의 정상 등교·하교 버튼을 확장 프로그램에서 실행합니다.",
  "version": "0.6.0",
  "minimum_chrome_version": "102",
  "permissions": [
    "alarms",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://techcourse-lms-plus-web.woowahan.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LMS+ 출석 도우미",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
